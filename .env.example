# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# JWT secret — change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Teacher credentials (used by seed script)
TEACHER_EMAIL=teacher@satplatform.com
TEACHER_PASSWORD=changeme123
TEACHER_NAME=SAT Tutor

# Google OAuth (optional — leave blank to use email/password fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# App base URL
APP_URL=http://localhost:3000
